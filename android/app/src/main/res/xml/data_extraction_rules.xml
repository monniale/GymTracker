<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Nothing goes to Google Drive: WebView storage (app_webview) holds the GitHub PAT
     and the Gemini key in localStorage. Device-to-device transfer to the owner's next phone stays allowed.
     The real backups are GitHub Sync and the JSON export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
