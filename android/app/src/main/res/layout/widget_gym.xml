<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (GymWidgetProvider). RemoteViews-safe views only. The sample texts double as
     the picker preview (previewLayout); the provider overwrites them or shows widget_empty. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="@string/widget_sample_tier"
                android:textColor="@color/gt_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="@string/widget_sample_points"
                android:textColor="@color/gt_ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_streak"
            android:textColor="@color/gt_sub"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_week_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="3"
            android:progress="2"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="@string/widget_sample_week"
            android:textColor="@color/gt_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sample_next"
            android:textColor="@color/gt_ink"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/gt_sub"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
