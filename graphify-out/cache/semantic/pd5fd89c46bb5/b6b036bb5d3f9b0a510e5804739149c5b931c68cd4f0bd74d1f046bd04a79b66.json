{"nodes": [{"id": "public_icons_icon_192", "label": "icon-192.png (GymTracker app icon, 192x192)", "file_type": "image", "source_file": "public/icons/icon-192.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_icons_icon_192_dumbbell_glyph", "label": "Orange dumbbell glyph (bar with two plates per side)", "file_type": "image", "source_file": "public/icons/icon-192.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_icons_icon_192_pwa_app_icon", "label": "PWA app icon (192x192 manifest icon)", "file_type": "concept", "source_file": "public/icons/icon-192.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "192x192 PNG declared in the VitePWA manifest.icons of vite.config.ts (type image/png, default purpose 'any'). Chrome/Android installability expects 192px and 512px PNG icons: this size is the home-screen/launcher icon, icon-512.png is the large/splash-size variant, maskable-512.png (purpose 'maskable') is the adaptive-icon variant with extra safe-zone padding, and apple-touch-icon.png (180px, linked from index.html) is the iOS home-screen counterpart. Matched by the Workbox precache glob (**/*.png) so it is available offline."}, {"id": "public_icons_icon_192_brand_palette", "label": "GymTracker brand palette (#0B0F14 near-black + #F97316 orange)", "file_type": "rationale", "source_file": "public/icons/icon-192.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The icon reuses the app's exact theme colors: near-black #0B0F14 (Tailwind 'bg' token and manifest theme_color/background_color; fills about 80% of the pixels) and orange #F97316 (Tailwind 'primary' token; the dumbbell fill). Keeping icon, splash background, browser theme-color and in-app UI on one palette makes the installed app feel native. The colors are baked into raster pixels and no build script generates the icons (none exists in the repo), so changing the Tailwind tokens or manifest colors requires regenerating the PNG icons manually."}], "edges": [{"source": "public_icons_icon_192", "target": "public_icons_icon_192_dumbbell_glyph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "public_icons_icon_192", "target": "public_icons_icon_192_pwa_app_icon", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "public_icons_icon_192", "target": "public_icons_icon_192_brand_palette", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "vite_config", "target": "public_icons_icon_192", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "vite_config", "target": "public_icons_icon_192_brand_palette", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "tailwind_config", "target": "public_icons_icon_192_brand_palette", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "public_icons_icon_192", "target": "tailwind_config", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "public/icons/icon-192.png", "source_location": null, "weight": 1.0}, {"source": "public_icons_icon_192", "target": "public_ico