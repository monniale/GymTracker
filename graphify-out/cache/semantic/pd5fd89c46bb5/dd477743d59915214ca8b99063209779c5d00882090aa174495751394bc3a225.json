{"nodes": [{"id": "readme", "label": "README.md \u2014 GymTracker overview", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_offline_first_on_device_data", "label": "Offline-first, all data on device (IndexedDB)", "file_type": "rationale", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-user PWA installed from Safari that runs fully offline and keeps all data on the phone. The README still says Open Food Facts search is the only network call \u2014 outdated now that USDA FDC, Gemini AI and opt-in GitHub snapshot sync exist."}, {"id": "readme_open_food_facts", "label": "Open Food Facts (OFF)", "file_type": "concept", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free, CORS-open food database used for text search and barcode lookup, with results cached locally for offline reuse; OFF rows keep the bare EAN as offId, which keeps the dedup key backward-compatible."}, {"id": "readme_workout_logging", "label": "Workout logging (templates, supersets, one-tap sets, warm-ups, plate calculator)", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-tap set logging is pre-filled from the last session; warm-up ramps and the plate calculator are barbell-only."}, {"id": "readme_double_progression", "label": "Double progression (auto-progression suggestions)", "file_type": "rationale", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule-based next weight/rep suggestion; it is the offline baseline behind the AI opening-weight suggestions."}, {"id": "readme_rest_timer", "label": "Rest timer (auto-start, timestamp-based, wake lock)", "file_type": "concept", "source_file": "README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timestamp-based so it survives backgrounding/relaunch; short 30s rest after warm-ups and held until the last superset member; the screen wake lock exists because iOS only plays the beep while the app is on screen."}, {"id": "readme_diet_tracking", "label": "Diet tracking (meal log, training/rest-day macro targets, recipes, water)", "file_type": "concept", "source_file": "README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Your macro overrides always win over database values, online search results are cached locally for offline reuse, and recipes are cooked once then logged per portion."}, {"id": "readme_barcode_scanner", "label": "Camera barcode scanner (zxing WASM)", "file_type": "concept", "source_file": "README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "zxing WASM is bundled (no CDN) and yields EAN-13 codes; manual entry is the fallback."}, {"id": "readme_progress_tracking", "label": "Progress tracking (e1RM/volume charts, muscle volume, PR wall, strength standards)", "file_type": "concept", "source_file": "README.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly sets per muscle are compared with the 10\u201320 set evidence band; the PR wall shows strength-standard levels from Novice to Elite."}, {"id": "readme_ranking_system", "label": "Rainbow-Six-style ranking (Copper III \u2192 Champion)", "file_type": "concept", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gamification on top of the score: 12-week seasons with recap and a ghost race against the previous season, idle decay, deterministic weekly quests (+15 pts), achievements and PR confetti."}, {"id": "readme_evidence_based_score", "label": "Evidence-based workout score", "file_type": "rationale", "source_file": "README.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volume load \u00f7 bodyweight weighted by relative intensity (% of Epley-estimated 1RM), plus PR bonuses for progressive overload, a weekly-consistency streak multiplier, junk-volume caps and idle decay."}, {"id": "readme_json_backup", "label": "JSON backup export/import", "file_type": "concept", "source_file": "README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting the app icon or wiping Safari website data also deletes IndexedDB, so export a backup (iOS share sheet) now and then."}, {"id": "readme_ios_pwa_install", "label": "iPhone install via Safari Add to Home Screen", "file_type": "concept", "source_file": "README.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Launching from the home-screen icon gives a standalone, offline-capable app whose data stays on the phone."}, {"id": "readme_ios_pwa_limits", "label": "iOS PWA limits", "file_type": "concept", "source_file": "README.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imposed by iOS: the timer beep only plays while the app is on screen, there is no vibration API and no push-free local notifications, and IndexedDB is wiped along with the icon or Safari website data."}, {"id": "readme_alternative_deploy", "label": "Alternative deploy (gh-pages branch / Netlify Drop)", "file_type": "concept", "source_file": "README.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without CI: npm run deploy publishes to the gh-pages branch, or build with BASE_PATH=/ and drag dist/ onto Netlify Drop."}, {"id": "readme_base_path_repo_name", "label": "Pages base path must match repo name (/GymTracker/)", "file_type": "rationale", "source_file": "README.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub Pages serves the app at https://<user>.github.io/GymTracker/, so the repo name must match the base path in vite.config.ts (change it there for a different name)."}], "edges": [{"source": "readme", "target": "readme_offline_first_on_device_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme", "target": "readme_workout_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L9", "weight": 1.0}, {"source": "readme", "target": "readme_rest_timer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L13", "weight": 1.0}, {"source": "readme", "target": "readme_diet_tracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L16", "weight": 1.0}, {"source": "readme", "target": "readme_progress_tracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L21", "weight": 1.0}, {"source": "readme", "target": "readme_ranking_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L24", "weight": 1.0}, {"source": "readme", "target": "readme_json_backup", "relation": "references", "confidence": "EXTRACTED", "confid