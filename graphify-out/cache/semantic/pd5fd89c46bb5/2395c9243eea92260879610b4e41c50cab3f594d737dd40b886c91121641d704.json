, "weight": 1.0}, {"source": "android", "target": "routemap_invariant_native_pwa_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android", "target": "routemap_invariant_identity_permanent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android", "target": "routemap_invariant_notification_ids", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android", "target": "routemap_invariant_channels_immutable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android", "target": "routemap_invariant_localnotifications_discipline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android_capacitor_wrapper", "target": "capacitor_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android_capacitor_wrapper", "target": "ref_capacitor_android", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android_capacitor_wrapper", "target": "routemap_native_android_capacitor", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ANDROID.md", "source_location": null, "weight": 1.0}, {"source": "android_permanent_identity", "target": "capacitor_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ANDROID.md", "so