{
  "name": "gymtracker",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build --mode android",
    "cap:sync": "npm run build:android && cap sync android",
    "android:debug": "npm run cap:sync && . scripts/android/env.sh && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && . scripts/android/env.sh && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "TZ=Europe/Rome LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 vitest run",
    "demo:build": "DEMO_OUT=public/demo-backup.json TZ=Europe/Rome LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 vitest run scripts/demo",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "barcode-detector": "^3.2.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5",
    "zxing-wasm": "^3.1.0"
  },
  "overrides": {
    "workbox-build": "7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
